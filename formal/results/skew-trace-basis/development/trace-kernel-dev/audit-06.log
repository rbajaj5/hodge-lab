HodgeLab.OneReflectionSkew.TraceKernel.trace_eq_last_coefficient.{u_1, u_2} {K : Type u_1} {V : Type u_2} [Field K]
  [AddCommGroup V] [Module K V] {n : ℕ} (b : Module.Basis (Fin (n + 1)) K V) (T : V →ₗ[K] K) {c : K}
  (hzero : ∀ (i : Fin n), T (b i.castSucc) = 0) (hlast : T (b (Fin.last n)) = c) (v : V) :
  T v = (b.repr v) (Fin.last n) * c
HodgeLab.OneReflectionSkew.TraceKernel.mem_ker_iff_last_coefficient_eq_zero.{u_1, u_2} {K : Type u_1} {V : Type u_2}
  [Field K] [AddCommGroup V] [Module K V] {n : ℕ} (b : Module.Basis (Fin (n + 1)) K V) (T : V →ₗ[K] K) {c : K}
  (hzero : ∀ (i : Fin n), T (b i.castSucc) = 0) (hlast : T (b (Fin.last n)) = c) (hc : c ≠ 0) (v : V) :
  v ∈ T.ker ↔ (b.repr v) (Fin.last n) = 0
