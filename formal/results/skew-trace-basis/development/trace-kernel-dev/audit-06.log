HodgeLab.OneReflectionSkew.TraceKernel.kernelBasis_repr.{u_1, u_2} {K : Type u_1} {V : Type u_2} [Field K]
  [AddCommGroup V] [Module K V] {n : ℕ} (b : Module.Basis (Fin (n + 1)) K V) (T : V →ₗ[K] K) {c : K}
  (hzero : ∀ (i : Fin n), T (b i.castSucc) = 0) (hlast : T (b (Fin.last n)) = c) (hc : c ≠ 0) (v : ↥T.ker) (i : Fin n) :
  ((kernelBasis b T hzero hlast hc).repr v) i = (b.repr ↑v) i.castSucc
